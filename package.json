{
  "name": "oxapay-ts",
  "version": "0.1.0",
  "description": "TypeScript client for the OxaPay v1 API.",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./webhooks": {
      "types": "./dist/webhooks.d.mts",
      "import": "./dist/webhooks.js",
      "default": "./dist/webhooks.js"
    },
    "./fetch": {
      "types": "./dist/fetch.d.mts",
      "import": "./dist/fetch.js",
      "default": "./dist/fetch.js"
    },
    "./nextjs": {
      "types": "./dist/nextjs.d.mts",
      "import": "./dist/nextjs.js",
      "default": "./dist/nextjs.js"
    },
    "./express": {
      "types": "./dist/express.d.mts",
      "import": "./dist/express.js",
      "default": "./dist/express.js"
    },
    "./fastify": {
      "types": "./dist/fastify.d.mts",
      "import": "./dist/fastify.js",
      "default": "./dist/fastify.js"
    },
    "./hono": {
      "types": "./dist/hono.d.mts",
      "import": "./dist/hono.js",
      "default": "./dist/hono.js"
    }
  },
  "types": "./dist/index.d.mts",
  "files": ["dist"],
  "scripts": {
    "build": "unbuild",
    "check": "tsc --noEmit",
    "test:package": "bun run build && tsc --noEmit -p tsconfig.type-tests.json && node --test ./tests/package-integration.mjs",
    "sandbox": "bun run build && node ./scripts/sandbox-smoke.mjs",
    "test": "bun test"
  },
  "unbuild": {
    "declaration": "node16",
    "rollup": {
      "output": {
        "chunkFileNames": "shared/[name]-[hash].js",
        "entryFileNames": "[name].js"
      }
    }
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "unbuild": "^3.6.1"
  }
}
